# Copy to .env and fill in for local development. Nothing in this file is
# a real secret — DATABASE_URL below points at a local dev Postgres only.

DATABASE_URL=postgresql://najat360:najat360_dev@localhost:5432/najat360_dev

# Auth (Better Auth). Generate a real random value locally; never commit one.
AUTH_SECRET=

APP_URL=http://localhost:3000

# DEMO_MODE gates demo-only affordances (e.g. the Demo Role Switcher) —
# see docs/product/NAJAT360-قرارات-ما-بعد-C0.md correction #3. Must be
# "true" for local/demo use and unset/false in any non-demo deployment.
DEMO_MODE=true

# Routing provider: "mock" (the default) requires no API key at all and
# powers every ETA/coverage computation out of the box. Set to "arcgis"
# ONLY if you have your own ArcGIS Developer account with routing enabled
# AND have filled in both ARCGIS_ROUTE_URL and ARCGIS_API_KEY below — real
# routing behind Esri's paid "World Route Service", a DIFFERENT product
# from the free satellite-tile basemap (see NEXT_PUBLIC_ARCGIS_API_KEY
# further down, which is unrelated). If ROUTING_PROVIDER=arcgis but either
# var below is missing, or the ArcGIS call ever fails/times out, the app
# automatically and silently falls back to the mock provider (tagged
# providerMode: FALLBACK on the result) — see
# src/lib/routing/resilient-provider.ts. This app itself never signs up
# for ArcGIS or obtains a key; that stays a step you do yourself.
ROUTING_PROVIDER=mock
ARCGIS_ROUTE_URL=
ARCGIS_API_KEY=

NEXT_PUBLIC_MAP_STYLE_URL=

# Optional: the live incident map (app/_components/IncidentMap.tsx) already
# offers an Esri/ArcGIS "World Imagery" satellite basemap toggle that works
# with NO key at all (Esri's public tile REST endpoint). Set this ONLY if
# you have your own ArcGIS Developer account and want its higher rate
# limits / authenticated basemap tier — it must be NEXT_PUBLIC_ (not the
# ARCGIS_API_KEY above) because it is read in the browser. Never required.
NEXT_PUBLIC_ARCGIS_API_KEY=

# Optional override for scripts/seed-demo.ts — spec range is 1000-5000.
SEED_HISTORICAL_COUNT=2000
